#include <iostream>
using namespace std;

int main()
{
    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    // Dynamically allocate an array
    int *arr = new int[n];

    cout << "Enter " << n << " elements:" << endl;

    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    cout << "Array elements are: ";

    for (int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    // Deallocate the array
    delete[] arr;

    return 0;
}
